# =============================================================================
# NauDisha Backend Environment Configuration
# =============================================================================

# 1. Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# 2. Copernicus Marine Service (Ocean Currents & Waves)
# Optional: If not provided, Open-Meteo and mock providers are used as fallback
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# 3. Live Vessel AIS Tracking Provider (Real-Time GPS Coordinates)
# Optional: Free API Key from https://aisstream.io
AISSTREAM_API_KEY=
VESSEL_PROVIDER_API_KEY=

# 4. Frontend Integration URL (for CORS if restricted)
FRONTEND_URL=http://localhost:5173
